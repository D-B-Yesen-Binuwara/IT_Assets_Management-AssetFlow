DB_URL=jdbc:postgresql://localhost:5432/AssetsFlow
DB_USERNAME=postgres
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-bytes

# Comma-separated exact browser origins. Do not use * with credentialed CORS.
FRONTEND_URL=http://localhost:5173

# Local HTTP defaults. Use COOKIE_SECURE=true and COOKIE_SAME_SITE=None for HTTPS cross-site deployments.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
